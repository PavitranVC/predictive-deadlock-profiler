// PDP architecture v5 (Stage 5 and 6, final). Solid = built.
// Copy of arch-v4.dot (arch-v4.dot is unchanged) with: bank_fixed added to the test programs, the experiment
// harness shown as run (native runs, overhead, Helgrind, plot), its results (CSVs and charts) as nodes, and the
// Stage 6 live demo (scripts/demo.sh) as the driver of the whole pipeline.
digraph pdp_v5 {
    rankdir=TB;
    graph [fontname="Helvetica", fontsize=12, labelloc=t, pad=0.3, nodesep=0.5, ranksep=0.6];
    node  [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#e8f0fe", color="#1a56a8"];
    edge  [fontname="Helvetica", fontsize=10, color="#333333"];

    label="PDP v5 - interceptor (S1) + analyzer (S2) + ground-truth tests (S3) + confirmer (S4) + experiments (S5) + demo (S6)";

    prog [label="Unmodified C program\n(calls pthread_mutex_* / sem_*)", fillcolor="#ffffff"];

    subgraph cluster_tests {
        label="tests/ ground-truth programs (Stage 3)";
        style="rounded,dashed"; color="#1e7b3a"; fontcolor="#1e7b3a";

        bank    [label="bank.c\nreal 2-cycle (locks)", fillcolor="#ffffff", color="#1e7b3a"];
        bankfix [label="bank_fixed.c\nsame locks, one global order\nno cycle, slow run exits 0", fillcolor="#ffffff", color="#1e7b3a"];
        semsq   [label="sem_sq.c\nreal 2-cycle (semaphores S, Q)", fillcolor="#ffffff", color="#1e7b3a"];
        gate    [label="gate.c\nfiltered (gate_G), never hangs", fillcolor="#ffffff", color="#1e7b3a"];
        naive   [label="philo_naive.c\nreal 5-cycle", fillcolor="#ffffff", color="#1e7b3a"];
        ordered [label="philo_ordered.c\nno cycle, never hangs", fillcolor="#ffffff", color="#1e7b3a"];
        modes   [label="modes: seq (predict) | race N (natural)\n| slow (forced hang)\nstart barrier in race and slow", shape=note, fillcolor="#e6f4ea", color="#1e7b3a"];
        check   [label="check_suite.sh (make test)\nstrict asserts: one cycle, 5 distinct locks,\nclean programs never hang", fillcolor="#e6f4ea", color="#1e7b3a"];
    }

    subgraph cluster_pdp {
        label="libpdp.so (LD_PRELOAD)";
        style="rounded,dashed"; color="#1a56a8"; fontcolor="#1a56a8";

        hooks [label="Hooks\npthread_mutex_lock / unlock / trylock / destroy\nsem_wait / sem_post\n(pthread_barrier_wait: not hooked)"];
        table [label="Thread table\npdp_threads[64] (struct tcb)\nheld[16], waiting_on\nTLS: me, in_hook", fillcolor="#fff4d6", color="#b07d00"];
        lock  [label="tbl_lock\ntest-and-set spin lock", shape=octagon, fillcolor="#fff4d6", color="#b07d00"];
    }

    glibc [label="Real glibc (libc.so.6)\npthread_mutex_* / sem_*\nfound by dlsym(RTLD_NEXT)", fillcolor="#e6f4ea", color="#1e7b3a"];
    log   [label="pdp.log\n(O_APPEND, one write() per line)\n~7-11 us per lock op (S5)", shape=cylinder, fillcolor="#e6f4ea", color="#1e7b3a"];
    pdprun [label="pdp run [-o log] ./prog args\n(front end: sets LD_PRELOAD)", fillcolor="#e8f0fe", color="#1a56a8"];

    prog -> hooks [label="calls (LD_PRELOAD\nresolves to hook)"];
    hooks -> glibc [label="real call after REQ\n(dlsym RTLD_NEXT)"];
    hooks -> table [label="update held /\nwaiting_on"];
    table -> lock [label="under lock only", style=dotted, arrowhead=none];
    hooks -> log [label="REQ / ACQ / REL /\nFAIL / TRY_* / POST"];

    // Stage 3: the test programs are run through the front end, under LD_PRELOAD.
    modes -> bank [style=invis];
    bank -> pdprun [label="seq / race / slow"];
    bankfix -> pdprun;
    semsq -> pdprun;
    gate -> pdprun;
    naive -> pdprun;
    ordered -> pdprun;
    pdprun -> prog [label="runs"];
    pdprun -> log [label="writes"];
    check -> pdprun [label="seq run, then analyze"];

    subgraph cluster_analyzer {
        label="pdp-analyze (Stage 2): src/analyze.c, src/report.c";
        style="rounded,dashed"; color="#1a56a8"; fontcolor="#1a56a8";

        parser  [label="Parser\nread_log, parse_event, parse_held\nskip # lines, held=? counted\nsort by seq"];
        lockgraph [label="Lock-order graph\nnode = address + generation (DESTROY)\nedge A->B from REQ: tid, site, held set, count\ntrylock and recursive re-lock add no edge", fillcolor="#fff4d6", color="#b07d00"];
        cycles  [label="Cycle enumeration\nper start node, elementary cycles\nlength <= 8, 256 cycles, 200k steps\n(capped -> warning)"];
        filters [label="Filters (GoodLock)\npairwise distinct threads\npairwise disjoint held sets\nverdict: REAL / UNDECIDED / FILTERED", fillcolor="#fff4d6", color="#b07d00"];
        report  [label="Report\ncoloured text, exit 0 / 2 / 1\nnames: lk= + nm, else L1, L2\nsites: addr2line"];
        fix     [label="F(R) fix\ndrop least frequent edge per real cycle\nKahn topological sort -> lock order\nall call sites listed"];
        dot     [label="Graphviz .dot\n(pdp analyze renders .png)"];

        parser -> lockgraph [label="events"];
        lockgraph -> cycles [label="adjacency"];
        cycles -> filters [label="cycles"];
        filters -> report [label="verdicts"];
        report -> fix [label="REAL cycles"];
        report -> dot [label="--dot"];
    }

    subgraph cluster_experiments {
        label="Experiment harness (Stage 5): scripts/, full run done";
        style="rounded,dashed"; color="#1a56a8"; fontcolor="#1a56a8";

        experiment [label="run_experiment.sh\nnative race 1000, no LD_PRELOAD\nscheduler x cores x idle/loaded x 200 runs\nhung = exit 124 at TIMEOUT_S=1\n10,800 runs, 0 errors", fillcolor="#e8f0fe", color="#1a56a8"];
        overhead   [label="overhead.sh\nphilo_ordered, gate: baseline vs LD_PRELOAD\n50 pairs per ITER (1k, 10k, 100k)", fillcolor="#e8f0fe", color="#1a56a8"];
        helgrind   [label="helgrind.sh\nvalgrind --tool=helgrind\n5 binaries, lock-order reports", fillcolor="#e8f0fe", color="#1a56a8"];
        plot       [label="plot.py\nWilson 95% CIs, charts,\nsummary table", fillcolor="#e8f0fe", color="#1a56a8"];
    }

    subgraph cluster_results {
        label="results/ (Stage 5 outputs)";
        style="rounded,dashed"; color="#1e7b3a"; fontcolor="#1e7b3a";

        manifest [label="manifest.csv\n10,800 rows", shape=cylinder, fillcolor="#e6f4ea", color="#1e7b3a"];
        ovcsv    [label="overhead.csv\n600 rows", shape=cylinder, fillcolor="#e6f4ea", color="#1e7b3a"];
        hgcsv    [label="helgrind.csv", shape=cylinder, fillcolor="#e6f4ea", color="#1e7b3a"];
        envtxt   [label="env.txt\nmachine, kernel, WSL, load", shape=note, fillcolor="#e6f4ea", color="#1e7b3a"];
        charts   [label="hangrate_*.png, overhead.png", shape=note, fillcolor="#e6f4ea", color="#1e7b3a"];
    }

    experiment -> bank [label="runs race 1000\n(no LD_PRELOAD)"];
    experiment -> semsq [label="runs race 1000"];
    experiment -> naive [label="runs race 1000"];
    experiment -> manifest [label="one row per run"];
    experiment -> envtxt [label="records"];
    overhead -> ordered [label="baseline vs PDP"];
    overhead -> gate [label="baseline vs PDP"];
    overhead -> pdprun [label="LD_PRELOAD=libpdp.so"];
    overhead -> ovcsv [label="one row per run"];
    helgrind -> bank [label="valgrind"];
    helgrind -> gate [label="valgrind"];
    helgrind -> naive [label="valgrind"];
    helgrind -> hgcsv;
    manifest -> plot;
    ovcsv -> plot;
    plot -> charts [label="writes"];

    // Stage 4: confirmer loop. Predict (analyzer), confirm (pdp confirm), verdict.
    subgraph cluster_confirmer {
        label="Confirmer (Stage 4): pdp confirm (src/pdp)";
        style="rounded,dashed"; color="#1a56a8"; fontcolor="#1a56a8";

        sites    [label="analyzer --sites\nREQ call sites of each REAL cycle", fillcolor="#fff4d6", color="#b07d00"];
        confirm  [label="pdp confirm -n N -t T\nN runs under timeout -k 1, stdin </dev/null\ndeadlocked = exit 42 AND own DEADLOCK line", fillcolor="#fff4d6", color="#b07d00"];
        delayrun [label="program run with\nPDP_DELAY_SITE=<sites>, PDP_WATCHDOG=1\n(--baseline: no delay)"];
        watchdog [label="watchdog thread (lazy start)\nevery 50 ms: snapshot, wait-for graph,\n3 equal scans -> _exit(42)", fillcolor="#fff4d6", color="#b07d00"];
        verdict  [label="verdict\nCONFIRMED if >= 1 deadlocked run\nexit 0 / 2 / 1", shape=note, fillcolor="#e6f4ea", color="#1e7b3a"];

        sites -> confirm [label="sites"];
        confirm -> delayrun [label="runs N times"];
        delayrun -> hooks [label="delay before 2nd lock\n(maybe_delay)"];
        hooks -> watchdog [label="first hooked call starts it"];
        watchdog -> log [label="# pdp DEADLOCK line"];
        watchdog -> confirm [label="exit 42", style=dashed];
        confirm -> verdict;
    }

    report -> sites [label="--sites"];
    log -> parser [label="reads"];

    // Stage 6: the live demo drives the whole pipeline in order.
    subgraph cluster_demo {
        label="Live demo (Stage 6): scripts/demo.sh";
        style="rounded,dashed"; color="#b07d00"; fontcolor="#b07d00";

        demo [label="demo.sh\n0 build, 1 clean pass, 2 hang (top, gdb)\n3 predict, 4 confirm, 5 fixed, 6 gate, 7 chart", fillcolor="#fff4d6", color="#b07d00"];
    }

    demo -> bank [label="seq, slow"];
    demo -> pdprun [label="run, analyze"];
    demo -> confirm [label="confirm --baseline"];
    demo -> bankfix [label="fixed version"];
    demo -> gate [label="filtered"];
    demo -> charts [label="step 7"];
}
