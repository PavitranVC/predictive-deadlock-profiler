# pdp v1 pid=1 exe=/nonexistent/prog
# T1 holds R, takes A, re-locks R (recursive). T2: R then A. No deadlock.
0 1 REQ M 0x10 /nonexistent/prog+0x10 held=-
1 1 REQ M 0xa0 /nonexistent/prog+0x20 held=0x10
2 1 REQ M 0x10 /nonexistent/prog+0x30 held=0x10,0xa0
3 2 REQ M 0x10 /nonexistent/prog+0x40 held=-
4 2 REQ M 0xa0 /nonexistent/prog+0x50 held=0x10
