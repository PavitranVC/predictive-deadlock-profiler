# pdp v1 pid=1 exe=/nonexistent/prog
# thread 101 uses A then B (0xb0), then B is destroyed. 0xb0 is reused for a NEW
# mutex that thread 102 holds while asking for A. Same address != same lock.
0 101 REQ M 0xa0 /nonexistent/prog+0x10 held=-
1 101 ACQ M 0xa0 /nonexistent/prog+0x10 held=-
2 101 REQ M 0xb0 /nonexistent/prog+0x20 held=0xa0
3 101 ACQ M 0xb0 /nonexistent/prog+0x20 held=0xa0
4 101 REL M 0xb0 /nonexistent/prog+0x28 held=0xa0
5 101 REL M 0xa0 /nonexistent/prog+0x30 held=-
6 101 DESTROY M 0xb0 /nonexistent/prog+0x38 held=-
7 102 REQ M 0xb0 /nonexistent/prog+0x40 held=-
8 102 ACQ M 0xb0 /nonexistent/prog+0x40 held=-
9 102 REQ M 0xa0 /nonexistent/prog+0x50 held=0xb0
10 102 ACQ M 0xa0 /nonexistent/prog+0x50 held=0xb0
